# Copy to .env and fill in. Never commit .env.
# Used by compose.yaml for the local PostgreSQL container.
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
# Database created on first init (default ecommerce_oltp). Homelab: postgres (creates nothing extra).
# POSTGRES_DB=ecommerce_oltp
# Compose project name; scopes the container and volume names. Homelab: ecomgen_homelab
# COMPOSE_PROJECT_NAME=
# postgresql://USER:PASSWORD@HOST:PORT/ecommerce_oltp  (homelab: .../ecommerce_homelab_test)
ECOMMERCE_DATABASE_URL=
# Integration tests create and drop throwaway databases here; needs CREATEDB. Unset = tests skipped.
ECOMGEN_TEST_DATABASE_URL=
