# Copy to .env and fill in. Never commit .env.
# Used by compose.yaml for the local PostgreSQL container (macOS dev; the homelab uses the host's PostgreSQL).
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
# Database created on first init (default ecommerce_oltp).
# POSTGRES_DB=ecommerce_oltp
# Compose project name; scopes the container and volume names.
# COMPOSE_PROJECT_NAME=
# postgresql://USER:PASSWORD@HOST:PORT/ecommerce_oltp  (homelab: ecomgen_app@127.0.0.1:5432/ecommerce_homelab_test)
ECOMMERCE_DATABASE_URL=
# Integration tests create and drop throwaway databases here; needs CREATEDB. Unset = tests skipped (always unset on the homelab).
ECOMGEN_TEST_DATABASE_URL=
# Where generate publishes CSV/JSONL feeds (must exist; overrides filesystem.root). Homelab: /srv/homelab/ecommerce/data
ECOMGEN_DATA_ROOT=
